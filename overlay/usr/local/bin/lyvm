#!/bin/bash
# lyvm - Lyarnix Virtual Machine launcher (wraps quickemu/quickget)
# Named lyvm (not lvm) because `lvm` is already Logical Volume Manager.
VMDIR="$HOME/Lyarnix/VMs"
mkdir -p "$VMDIR"; cd "$VMDIR" || exit 1

start_vm() { quickemu --vm "$1"; }

get_windows() {
  local v="$1"
  if [ ! -f "windows-$v.conf" ]; then
    echo "Downloading Windows $v from Microsoft (needs internet, several GB)..."
    quickget windows "$v" || { echo "Download failed."; read -rp "Press Enter..."; return; }
  fi
  echo "Note: Windows still needs your own license key to activate."
  start_vm "windows-$v.conf"
}

while true; do
  clear
  echo "###########################################"
  echo "Linux Lyarnix Virtual Machine"
  echo "###########################################"
  echo
  echo "Choose an OS"
  echo
  echo "[1] Windows 10"
  echo "[2] Windows 11"
  i=3; declare -A ISOS=()
  for iso in *.iso; do
    [ -e "$iso" ] || continue
    echo "[$i] $iso"; ISOS[$i]="$iso"; i=$((i+1))
  done
  echo
  echo "[0] Exit"
  echo
  read -rp "Selection: " c
  case "$c" in
    0) exit 0 ;;
    1) get_windows 10 ;;
    2) get_windows 11 ;;
    *) iso="${ISOS[$c]}"
       if [ -n "$iso" ]; then
         conf="${iso%.iso}.conf"
         if [ ! -f "$conf" ]; then
           read -rp "Guest type for $iso (linux/windows/other) [linux]: " g; g=${g:-linux}
           printf 'guest_os="%s"\ndisk_img="%s/disk.qcow2"\niso="%s"\ndisk_size="64G"\n' "$g" "${iso%.iso}" "$iso" > "$conf"
           mkdir -p "${iso%.iso}"
         fi
         start_vm "$conf"
       else echo "Invalid choice"; sleep 1; fi ;;
  esac
done
